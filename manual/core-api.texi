@section Construction
@cindex Construction

@deffn {Function} make-gapbuffer @t{#!key} (initial-capacity 0) (fill #\_) (min-capacity 5) (expand-factor 1.5)
Creates a new gapbuffer-based flexichain.

@table @var
@item initial-capacity
Initial capacity of the internal buffer (default: 0)
@item fill
Fill element for unused buffer positions (default: #\_)
@item min-capacity
Minimum buffer capacity (default: 5)
@item expand-factor
Factor by which buffer grows when full (default: 1.5)
@end table

@lisp
(module example-construction (library flexichain))

;; Create with defaults
(define chain1 (make-gapbuffer))

;; Create with custom parameters
(define chain2 (make-gapbuffer :initial-capacity 100 
                               :expand-factor 2.0))
@end lisp
@end deffn

@deffn {Function} list->gapbuffer list
Creates a new gapbuffer containing the elements from @var{list}.

@lisp
(module example-list-conversion (library flexichain))

(define chain (list->gapbuffer '("a" "b" "c")))
(flexi-length chain) ; => 3
(flexi-ref chain 1)  ; => "b"
@end lisp
@end deffn

