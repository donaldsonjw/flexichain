@section Basic Operations
@cindex Basic Operations

The core flexichain API provides fundamental operations for sequence manipulation.

@subsection Length and Access

@deffn {Generic Function} flexi-length chain
Returns the number of elements in @var{chain}.

@lisp
(module example-basic-ops (library flexichain))

(define chain (make-gapbuffer))
(flexi-insert! chain 0 "a")
(flexi-insert! chain 1 "b")
(flexi-length chain) ; => 2
@end lisp
@end deffn

@deffn {Generic Function} flexi-empty? chain
Returns @code{#t} if @var{chain} contains no elements, @code{#f} otherwise.

@lisp
(module example-empty-check (library flexichain))

(define chain (make-gapbuffer))
(flexi-empty? chain) ; => #t
(flexi-insert! chain 0 "item")
(flexi-empty? chain) ; => #f
@end lisp
@end deffn

@deffn {Generic Function} flexi-ref chain position
Returns the element at @var{position} in @var{chain}. Positions are zero-indexed.

@lisp
(module example-ref (library flexichain))

(define chain (make-gapbuffer))
(flexi-insert! chain 0 "first")
(flexi-insert! chain 1 "second")
(flexi-ref chain 0) ; => "first"
(flexi-ref chain 1) ; => "second"
@end lisp
@end deffn

@deffn {Generic Function} flexi-set! chain position item
Sets the element at @var{position} in @var{chain} to @var{item}.

@lisp
(module example-set (library flexichain))

(define chain (make-gapbuffer))
(flexi-insert! chain 0 "old")
(flexi-set! chain 0 "new")
(flexi-ref chain 0) ; => "new"
@end lisp
@end deffn

@subsection Insertion Operations

@deffn {Generic Function} flexi-insert! chain position item
Inserts @var{item} at @var{position} in @var{chain}. All elements at or after @var{position} are shifted right.

@lisp
(module example-insert (library flexichain))

(define chain (make-gapbuffer))
(flexi-insert! chain 0 "a")
(flexi-insert! chain 1 "c")
(flexi-insert! chain 1 "b")  ; Insert between "a" and "c"
;; chain now contains: "a" "b" "c"
@end lisp
@end deffn

@deffn {Generic Function} flexi-insert-vector! chain position vector
Inserts all elements from @var{vector} starting at @var{position} in @var{chain}.

@lisp
(module example-insert-vector (library flexichain))

(define chain (make-gapbuffer))
(flexi-insert! chain 0 "start")
(flexi-insert-vector! chain 1 #("middle1" "middle2"))
(flexi-insert! chain 3 "end")
;; chain now contains: "start" "middle1" "middle2" "end"
@end lisp
@end deffn

@subsection Deletion Operations

@deffn {Generic Function} flexi-delete! chain position
Removes the element at @var{position} from @var{chain}. All elements after @var{position} are shifted left.

@lisp
(module example-delete (library flexichain))

(define chain (make-gapbuffer))
(flexi-insert! chain 0 "a")
(flexi-insert! chain 1 "b")
(flexi-insert! chain 2 "c")
(flexi-delete! chain 1)  ; Remove "b"
;; chain now contains: "a" "c"
@end lisp
@end deffn

@deffn {Generic Function} flexi-delete-items! chain position count
Removes @var{count} elements starting at @var{position} from @var{chain}.

@lisp
(module example-delete-items (library flexichain))

(define chain (make-gapbuffer))
(flexi-insert-vector! chain 0 #("a" "b" "c" "d" "e"))
(flexi-delete-items! chain 1 3)  ; Remove "b", "c", "d"
;; chain now contains: "a" "e"
@end lisp
@end deffn

@subsection Rotation Operations

@deffn {Generic Function} flexi-rotate! chain n
Rotates the elements in @var{chain} by @var{n} positions. Positive values rotate right, negative values rotate left.

@lisp
(module example-rotate (library flexichain))

(define chain (make-gapbuffer))
(flexi-insert-vector! chain 0 #("a" "b" "c" "d"))
(flexi-rotate! chain 1)  ; Rotate right by 1
;; chain now contains: "d" "a" "b" "c"
@end lisp
@end deffn

