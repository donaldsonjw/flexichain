@section Text Editor Example
@cindex Text Editor Example

This example demonstrates how to use flexichain to implement a simple text editor with efficient insertion and deletion operations.

@lisp
(module text-editor-example (library flexichain))

;; Simple text editor using flexichain
(define-class <text-editor>
   buffer::<cursorchain>
   cursor::<flexicursor>)

(define (make-text-editor)
   (let* ((buffer (make-cursorchain))
          (cursor (make-cursorchain-left-cursor buffer :position 0)))
      (instantiate::<text-editor> (buffer buffer) (cursor cursor))))

;; Insert text at cursor position
(define (editor-insert! editor::text-editor text::string)
   (with-access::<text-editor> editor (cursor)
      (cursor-insert! cursor text)
      (cursor-move> cursor 0)))  ; Move cursor after inserted text

;; Delete character before cursor (backspace)
(define (editor-backspace! editor::text-editor)
   (with-access::<text-editor> editor (cursor)
      (unless (cursor-at-beginning? cursor)
         (cursor-delete<! cursor 1))))

;; Delete character after cursor (delete)
(define (editor-delete! editor::text-editor)
   (with-access::<text-editor> editor (cursor)
      (unless (cursor-at-end? cursor)
         (cursor-delete>! cursor 1))))

;; Move cursor left
(define (editor-move-left! editor::text-editor)
   (with-access::<text-editor> editor (cursor)
      (unless (cursor-at-beginning? cursor)
         (cursor-move< cursor 1))))

;; Move cursor right  
(define (editor-move-right! editor::text-editor)
   (with-access::<text-editor> editor (cursor)
      (unless (cursor-at-end? cursor)
         (cursor-move> cursor 1))))

;; Get current cursor position
(define (editor-cursor-position editor::text-editor)
   (with-access::<text-editor> editor (cursor)
      (cursor-pos cursor)))

;; Get text length
(define (editor-length editor::text-editor)
   (with-access::<text-editor> editor (buffer)
      (flexi-length buffer)))

;; Get character at position
(define (editor-char-at editor::text-editor position::long)
   (with-access::<text-editor> editor (buffer)
      (flexi-ref buffer position)))

;; Example usage
(define editor (make-text-editor))

;; Type some text
(editor-insert! editor "H")
(editor-insert! editor "e")
(editor-insert! editor "l")
(editor-insert! editor "l")
(editor-insert! editor "o")

;; Current state: "Hello" with cursor at end
(editor-length editor)          ; => 5
(editor-cursor-position editor) ; => 5

;; Move cursor and insert
(editor-move-left! editor)      ; Cursor at position 4
(editor-move-left! editor)      ; Cursor at position 3  
(editor-insert! editor " ")     ; Insert space
(editor-insert! editor "W")
(editor-insert! editor "o")
(editor-insert! editor "r")
(editor-insert! editor "l")
(editor-insert! editor "d")

;; Current state: "Hel World" with cursor after "d"
;; Move to end and add exclamation
(while (not (cursor-at-end? (-> editor cursor)))
   (editor-move-right! editor))
(editor-insert! editor "!")

;; Final state: "Hel World!"
@end lisp

