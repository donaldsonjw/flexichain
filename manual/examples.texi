@section Syntax Analyzer Example
@cindex Syntax Analyzer Example

This example shows how to use ranked flexichains for syntax analysis where tokens need to know their position in the source.

@lisp
(module syntax-analyzer-example (library flexichain))

;; Define token types with position awareness
(define-class <token>::<element-rank-mixin>
   type::symbol
   value::string
   line::long
   column::long)

(define-class <syntax-analyzer>
   tokens::<ranked-gapbuffer>
   current-token::<token>)

(define (make-syntax-analyzer)
   (instantiate::<syntax-analyzer> 
      (tokens (make-ranked-gapbuffer))
      (current-token #f)))

;; Add a token to the analyzer
(define (analyzer-add-token! analyzer::syntax-analyzer 
                            type::symbol value::string 
                            line::long column::long)
   (with-access::<syntax-analyzer> analyzer (tokens)
      (let* ((position (flexi-length tokens))
             (token (instantiate::<token> 
                      (type type)
                      (value value) 
                      (line line)
                      (column column)
                      (index position)
                      (chain tokens))))
         (flexi-insert! tokens position token)
         token)))

;; Get token at specific position
(define (analyzer-token-at analyzer::syntax-analyzer position::long)
   (with-access::<syntax-analyzer> analyzer (tokens)
      (flexi-ref tokens position)))

;; Navigate tokens using rank methods
(define (token-next token::<token>)
   (flexi-next token))

(define (token-prev token::<token>)
   (flexi-prev token))

(define (token-is-first? token::<token>)
   (flexi-first? token))

(define (token-is-last? token::<token>)
   (flexi-last? token))

;; Example: Simple expression parser
(define (parse-expression analyzer::syntax-analyzer)
   (with-access::<syntax-analyzer> analyzer (tokens current-token)
      (when (> (flexi-length tokens) 0)
         (set! current-token (flexi-ref tokens 0))
         (parse-term analyzer))))

(define (parse-term analyzer::syntax-analyzer)
   (with-access::<syntax-analyzer> analyzer (current-token)
      (when current-token
         (case (-> current-token type)
            ((number)
             (let ((value (-> current-token value)))
                (unless (token-is-last? current-token)
                   (set! current-token (token-next current-token)))
                (string->number value)))
            ((identifier)
             (let ((name (-> current-token value)))
                (unless (token-is-last? current-token)
                   (set! current-token (token-next current-token)))
                name))
            (else
             (error "parse-term" "unexpected token" current-token))))))

;; Example usage
(define analyzer (make-syntax-analyzer))

;; Add tokens for expression "x + 42"
(analyzer-add-token! analyzer 'identifier "x" 1 1)
(analyzer-add-token! analyzer 'operator "+" 1 3)  
(analyzer-add-token! analyzer 'number "42" 1 5)

;; Navigate through tokens
(define first-token (analyzer-token-at analyzer 0))
(define second-token (token-next first-token))
(define third-token (token-next second-token))

;; Check positions
(rank first-token)  ; => 0
(rank second-token) ; => 1  
(rank third-token)  ; => 2

;; Parse the expression
(parse-expression analyzer) ; => x (first identifier)
@end lisp

